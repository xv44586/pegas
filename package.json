{
  "name": "pegas",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A conversation-first personal agent with durable tasks and recoverable execution.",
  "main": "dist/desktop/main.js",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:web && pnpm build:desktop",
    "build:desktop": "tsc -p desktop/tsconfig.json",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "check": "pnpm format:check && pnpm icons:check && pnpm lint && pnpm typecheck && pnpm deadcode && pnpm test:coverage && pnpm build",
    "deadcode": "knip --treat-config-hints-as-errors",
    "dev": "tsx src/control-plane/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:worker": "tsx src/worker/main.ts",
    "dev:scheduler": "tsx src/scheduler/main.ts",
    "desktop:run": "pnpm build && electron .",
    "dev:notification": "tsx src/notification/main.ts",
    "dev:supervisor": "tsx src/supervisor/main.ts",
    "backup": "tsx src/backup/main.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"web/**/*.{ts,tsx,css,html,json}\" \"scripts/**/*.{mjs,ts}\" \"docs/**/*.md\" \"*.{json,mjs,ts,yml,yaml}\" \"README.md\" \"AGENTS.md\" \"CONTRIBUTING.md\" \".github/**/*.{md,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"web/**/*.{ts,tsx,css,html,json}\" \"scripts/**/*.{mjs,ts}\" \"docs/**/*.md\" \"*.{json,mjs,ts,yml,yaml}\" \"README.md\" \"AGENTS.md\" \"CONTRIBUTING.md\" \".github/**/*.{md,yml}\"",
    "icons:check": "node scripts/generate-agent-icons.mjs --check",
    "icons:generate": "node scripts/generate-agent-icons.mjs",
    "lint": "eslint src test web scripts && pnpm lint:css-cascade",
    "lint:css-cascade": "tsx scripts/lint-css-cascade.ts",
    "review:evidence": "tsx scripts/generate-review-evidence.ts",
    "review:ui": "node scripts/capture-ui-review.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:desktop": "pnpm build && node scripts/smoke-desktop.mjs",
    "smoke:desktop:packaged": "PEGAS_DESKTOP_EXECUTABLE=releases/desktop/mac-arm64/Pegas.app/Contents/MacOS/Pegas node scripts/smoke-desktop.mjs",
    "package:mac": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "start": "node dist/control-plane/main.js",
    "start:supervisor": "node dist/supervisor/main.js",
    "start:notification": "node dist/notification/main.js",
    "start:worker": "node dist/worker/main.js",
    "start:backup": "node dist/backup/main.js",
    "start:scheduler": "node dist/scheduler/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p web/tsconfig.node.json --noEmit && tsc -p desktop/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "playwright": "^1.56.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.6",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "ai.pegas.desktop",
    "productName": "Pegas",
    "asarUnpack": [
      "dist/**/*",
      "node_modules/yaml/**/*"
    ],
    "directories": {
      "output": "releases/desktop"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "desktop/Pegas.icns",
      "target": [
        "dir"
      ]
    }
  }
}
