{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "test/**/*.ts",
    "src/desktop/**/*.ts",
    "src/executor/dsh-approval-bridge.mjs",
    "src/executor/dsh-readonly-surface.mjs"
  ]
}
