PEGAS_API_HOST=127.0.0.1
PEGAS_API_PORT=4317
# 实例访问令牌。留空时启动会在 PEGAS_DATA_DIR/api-token 自动生成随机 bearer（0600）并持久复用；
# Web 访问令牌门输入该文件内容即可。显式配置优先，不会被覆盖。
PEGAS_API_TOKEN=
PEGAS_DATA_DIR=./data
PEGAS_BACKUP_DIR=
PEGAS_EVENT_POLL_MS=250
PEGAS_SCHEDULER_POLL_MS=500
# 归类澄清待办有效期（毫秒，默认 72 小时）；到期由 Scheduler 幂等结算为已读并留下如实的过期事实，原消息保留可追溯。
PEGAS_ROUTING_CLARIFICATION_TTL_MS=259200000
PEGAS_EXECUTOR=dsh
PEGAS_DSH_COMMAND=dsh
PEGAS_DSH_PROFILE=headless
PEGAS_DSH_ADD_DIRS=
PEGAS_DSH_TIMEOUT_MS=3600000
# DSH 子会话落盘根目录；运行中与 Run 结束后从这里读取 subagent 完整执行记录（默认跟随 PEGAS_DSH_HOME：<dshHome>/sessions）
PEGAS_DSH_SESSIONS_ROOT=
# Agent 执行工作区；默认 ~/.pegas/workspaces/<dataDir 路径哈希前 12 位>，物理上在任何代码 checkout 之外（DSH 会从 cwd 向上加载 AGENTS.md）。显式设置可指向专用目录（不要指向开发仓库或其子目录）。
PEGAS_WORKSPACE_ROOT=
PEGAS_WORKER_CONCURRENCY=2
PEGAS_ROUTER=model
PEGAS_MODEL_PROVIDER=magpie
PEGAS_MODEL_BASE_URL=http://127.0.0.1:3425/v1
PEGAS_MODEL_API_KEY=
PEGAS_MODEL_TIMEOUT_MS=90000
PEGAS_PRIVACY_MODE=disabled
# Required when PEGAS_PRIVACY_MODE=mask. Use a stable random value with at least 16 characters.
PEGAS_PRIVACY_HMAC_KEY=
# 派生记忆默认关闭；首版只支持自托管 Hindsight。memory:up 默认固定到
# Hindsight v1.2.3 与 pgvector/pg18 的 linux/arm64 manifest digest；其他架构必须显式覆盖下列镜像。
PEGAS_MEMORY_PROVIDER=disabled
PEGAS_HINDSIGHT_BASE_URL=http://127.0.0.1:8888
# 启用 Hindsight 时必填。memory:up 用它配置服务端 ApiKeyTenantExtension 鉴权，
# Worker 用同一值作为 Bearer；未鉴权的 loopback API 会被本机任意进程读写。
PEGAS_HINDSIGHT_API_KEY=
# 启用 Hindsight 时必填的稳定随机密钥（至少 32 字符，建议 openssl rand -hex 32）；
# 只用于 owner/workspace 不可逆映射，不发送给 Provider。更换后既有 bank 映射会失效。
PEGAS_MEMORY_HMAC_KEY=
PEGAS_HINDSIGHT_TIMEOUT_MS=5000
PEGAS_MEMORY_SYNC_MS=60000
# `pnpm memory:up` 的受监督 Hindsight/PostgreSQL 运行配置。
# PEGAS_HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight@sha256:4b903ed2cbf029d6d305030b0005002d61d6a3b1d9b85867fb459351dcaa671c
# PEGAS_HINDSIGHT_POSTGRES_IMAGE=pgvector/pgvector@sha256:38681dc6eaf55308e2a4c6de392d131652dcfac70e1263e35cd9b5ea3fe39782
PEGAS_HINDSIGHT_DB_PASSWORD=
PEGAS_HINDSIGHT_DB_USER=hindsight
PEGAS_HINDSIGHT_DB_NAME=hindsight
PEGAS_HINDSIGHT_DB_VOLUME=pegas-hindsight-pg
PEGAS_HINDSIGHT_BACKUP_DIR=./data/hindsight-backups
PEGAS_HINDSIGHT_PORT=8888
PEGAS_HINDSIGHT_STARTUP_TIMEOUT_MS=600000
PEGAS_HINDSIGHT_LLM_PROVIDER=openai
PEGAS_HINDSIGHT_LLM_BASE_URL=http://host.docker.internal:3425/v1
PEGAS_HINDSIGHT_LLM_API_KEY=not-needed
PEGAS_HINDSIGHT_LLM_MODEL=discovery-api/deepseek-v4.1-flash-1017
PEGAS_REWRITE_MODE=disabled
PEGAS_SPEECH_PROVIDER=openai-compatible
PEGAS_SPEECH_BASE_URL=http://127.0.0.1:18081/v1
PEGAS_SPEECH_API_KEY=
PEGAS_SPEECH_MODEL=Qwen/Qwen3-ASR-0.6B
PEGAS_SPEECH_TIMEOUT_MS=120000
PEGAS_SPEECH_MAX_AUDIO_BYTES=26214400
PEGAS_PUSH_MODE=disabled
PEGAS_PUSH_WEBHOOK_URL=
PEGAS_PUSH_WEBHOOK_TOKEN=
PEGAS_OUTBOX_POLL_MS=500
PEGAS_OUTBOX_MAX_ATTEMPTS=8
PEGAS_RELEASES_DIR=./releases
PEGAS_SUPERVISOR_STATE=./data/supervisor.json
PEGAS_RECOVERY_HOST=127.0.0.1
PEGAS_RECOVERY_PORT=4318
PEGAS_RECOVERY_TOKEN=
PEGAS_STARTUP_GRACE_MS=15000
PEGAS_STABILIZATION_MS=10000
